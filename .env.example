# Load explicitly in your shell/operator tooling. Settings imports do not read .env.
# Local fixture; seed explicitly with python -m synthetic_demo.seed sqlite.
DB_PROFILE=local_synthetic
DB_DIALECT=sqlite
DB_SQLITE_PATH=var/synthetic/maintenance_v1.sqlite3
DB_SCHEMA_JSON=var/synthetic/schema-v1.json
DB_CONNECT_TIMEOUT_SECONDS=10
DB_QUERY_TIMEOUT_SECONDS=15
DB_CONNECT_RETRIES=2
DB_MAX_RESULT_ROWS=1000
DB_MAX_RESULT_BYTES=1048576
DB_SNAPSHOT_TTL_SECONDS=3600
DB_SAMPLE_ROWS=5
DB_SAMPLE_VALUE_CHARS=160
DB_SAMPLE_TOTAL_BYTES=65536
DB_SAMPLE_SCAN_ROWS=10000
DB_DISCOVERY_TIMEOUT_SECONDS=30
LLM_SCHEMA_CONTEXT_CHARS=16000

# Azure profile: replace local settings above rather than adding conflicts.
# DB_PROFILE=azure_sql
# DB_DIALECT=sqlserver
# DB_SERVER=YOUR_SERVER.database.windows.net
# DB_NAME=dbmind_synthetic_YOUR_DEMO
# DB_SCHEMA_SCOPE=demo
# DB_SCHEMA_JSON=var/synthetic/azure-schema-v1.json
# DB_AUTH=managed_identity
# DB_MANAGED_IDENTITY_CLIENT_ID=USER_ASSIGNED_IDENTITY_CLIENT_UUID
# For local Entra development use DB_AUTH=azure_cli instead.
# Optional restricted SQL-authentication alternative:
# DB_AUTH=sql_password
# DB_USER=YOUR_RESTRICTED_RUNTIME_USER
# DB_PASSWORD=YOUR_RUNTIME_SECRET_FROM_SECRET_STORE

# Own Azure SQL database: opt into the separate custom profile.
# DB_PROFILE=azure_sql_custom
# DB_NAME=YOUR_EXISTING_DATABASE
# DB_SCHEMA_SCOPE=dbo,sales
# DB_SCHEMA_JSON=var/custom/schema-v1.json
# Optional exact subset; unset includes all accessible user tables in those schemas.
# DB_TABLE_SCOPE=sales.orders,sales.customers
# DB_SAMPLE_ROWS=5
# APP_LLM_MODE=live
# Run python -m src.setup_database --env-file /PRIVATE/PATH/deployment.env

# Only for the optional loopback SQL Server lab:
# DB_PROFILE=local_sqlserver
# DB_SERVER=127.0.0.1,14333
# DB_TRUST_LOCAL_CERTIFICATE=true
# Setup credentials such as DBMIND_SQLSERVER_SETUP_PASSWORD never go here.

# External DeepSeek API: never supplied or changed through visitor/session input.
LLM_PROVIDER=deepseek
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# DEEPSEEK_API_KEY=YOUR_SECRET_FROM_SECRET_STORE
# Optional stage overrides: CG, SR, AN, FA, QC, QF, TR, EV. Pro is explicit.
# DEEPSEEK_AN_MODEL=deepseek-v4-pro
DEEPSEEK_THINKING=disabled
DEEPSEEK_REASONING_EFFORT=low
LLM_TIMEOUT_SECONDS=30
LLM_RETRIES=1
LLM_MAX_OUTPUT_TOKENS=2048
LLM_MAX_INPUT_CHARS=48000
LLM_MAX_OUTPUT_CHARS=16000
LLM_PIPELINE_MAX_CALLS=12
LLM_PIPELINE_TIMEOUT_SECONDS=300
LLM_ENABLE_EVALUATION=false
# Optional operator-reviewed, dated rates for DEEPSEEK_MODEL only. No built-in prices.
# LLM_RATES_DATE=YYYY-MM-DD
# LLM_INPUT_CACHE_HIT_USD_PER_M=REVIEWED_RATE
# LLM_INPUT_CACHE_MISS_USD_PER_M=REVIEWED_RATE
# LLM_OUTPUT_USD_PER_M=REVIEWED_RATE

# Initial recruiter demo: private HTTP Basic auth on EVERY route; use TLS remotely.
# APP_USERNAME=YOUR_PRIVATE_USER
# APP_PASSWORD=YOUR_PRIVATE_PASSWORD_AT_LEAST_12_CHARACTERS
# Alternatively APP_AUTH=user1:private_password,user2:another_private_password
# Optional separate operator login; never share with demo visitors. No default password.
# APP_ADMIN_USERNAME=admin
# APP_ADMIN_PASSWORD=YOUR_SEPARATE_PRIVATE_PASSWORD_AT_LEAST_12_CHARACTERS
APP_QUESTIONS_PER_HOUR=2
APP_QUESTIONS_PER_DAY=10
APP_MODEL_CALLS_PER_HOUR=24
APP_GLOBAL_MODEL_CALLS_PER_DAY=120
APP_REQUESTS_PER_HOUR=240
APP_MAX_SESSIONS_PER_USER=4
APP_SESSION_TTL_SECONDS=1800
APP_QUEUE_SIZE=8

# Local default host; Docker overrides host to 0.0.0.0. No Gradio share tunnel.
APP_HOST=127.0.0.1
PORT=7860
# Choose mock (exact bilingual fixture questions, no API key) or live (DeepSeek).
APP_LLM_MODE=mock
GRADIO_ANALYTICS_ENABLED=False
HF_HUB_OFFLINE=1
HF_HUB_DISABLE_TELEMETRY=1
